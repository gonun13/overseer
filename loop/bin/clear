#!/usr/bin/env bash
# Stop and delete open requests: removes every artifact a request owns, then
# appends a "cleared" event to db/<slug>/index.jsonl (files are deleted; the
# automation log never is — see README taxonomy). memory.md is never touched:
# it outlives any single request.
#
# Usage: loop/bin/clear <workspace-name> (--id <request-id> | --all) [--yes]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'EOF'
usage: loop/bin/clear <workspace-name> (--id <request-id> | --all) [--yes]

Stops and deletes open (not yet cleared) requests for
workspace/<workspace-name>. For each one: deletes every artifact it owns
(the raw text, the human's sign-off, and each step's record), takes down its
QA worktree, prunes the loop's metadata from its branch so it leaves the
train, and appends a "cleared" event to db/<slug>/index.jsonl.

The branch itself and any open pull request are left alone — deleting work
you may still want is not this command's call. It says which they were.

--id <id>   clear exactly one request
--all       clear every open request for this workspace
--yes       skip the confirmation prompt (required in non-interactive shells)

Exit codes: 0 ok, 1 general/validation failure.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

require_cmd jq

name="" id="" all=0 yes=0 repo="" branch=""
while [ $# -gt 0 ]; do
  case "$1" in
    --id)
      [ $# -ge 2 ] || die "--id requires a value" 1
      id=$2
      shift 2
      ;;
    --all)
      all=1
      shift
      ;;
    --yes)
      yes=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1" 1
      ;;
    *)
      if [ -n "$name" ]; then
        die "unexpected extra argument: $1" 1
      fi
      name=$1
      shift
      ;;
  esac
done

if [ -z "$name" ]; then
  usage
  exit 1
fi
if [ -n "$id" ] && [ "$all" -eq 1 ]; then
  die "pass either --id or --all, not both" 1
fi
if [ -z "$id" ] && [ "$all" -eq 0 ]; then
  die "must pass --id <request-id> or --all" 1
fi

validate_workspace_name "$name"
slug=$(slugify "$name")

# targets: one latest-event JSON line per request to clear.
targets=()
if [ -n "$id" ]; then
  event=$(request_event "$slug" "$id")
  [ -n "$event" ] || die "no request '$id' found for '$name'" 1
  status=$(printf '%s' "$event" | jq -r '.status')
  [ "$status" != "cleared" ] || die "request '$id' is already cleared" 1
  targets+=("$event")
else
  while IFS= read -r event; do
    [ -n "$event" ] || continue
    targets+=("$event")
  done < <(open_request_events "$slug")
fi

if [ ${#targets[@]} -eq 0 ]; then
  log_info "no open requests to clear for '$name'"
  exit 0
fi

log_info "about to clear ${#targets[@]} request(s) for '$name':"
for event in "${targets[@]}"; do
  printf '  - %s [%s/%s] %s\n' \
    "$(printf '%s' "$event" | jq -r '.id')" \
    "$(printf '%s' "$event" | jq -r '.step')" \
    "$(printf '%s' "$event" | jq -r '.status')" \
    "$(printf '%s' "$event" | jq -r '.title')" >&2
done

if [ "$yes" -ne 1 ]; then
  if [ ! -t 0 ]; then
    die "refusing to clear without --yes in a non-interactive shell" 1
  fi
  read -r -p "loop: delete these requests and their files? [y/N] " reply
  case "$reply" in
    y|Y|yes|YES) ;;
    *)
      log_info "aborted — nothing cleared"
      exit 0
      ;;
  esac
fi

for event in "${targets[@]}"; do
  id=$(printf '%s' "$event" | jq -r '.id')
  step=$(printf '%s' "$event" | jq -r '.step')
  title=$(printf '%s' "$event" | jq -r '.title')
  raw_ref=$(printf '%s' "$event" | jq -r '.raw_ref')
  record_ref=$(printf '%s' "$event" | jq -r '.record_ref')

  # Take the request out of the train before its records go. A cleared request
  # that kept its branch metadata would stay the base every later request is
  # stacked on, forever, with nothing left to explain why.
  repo="$WORKSPACE_ROOT/$name"
  if [ -d "$repo" ] && git_is_repo "$repo"; then
    branch=$(git_request_branch "$repo" "$id")
    if [ -n "$branch" ]; then
      "$LOOP_BIN_DIR/worktree" "$name" "$id" --remove >/dev/null 2>&1 || true
      git_unset_branch_meta "$repo" "$branch"
      log_info "branch '$branch' is no longer tracked by the loop — it and any pull request are still there"
    fi
  fi

  clear_request "$slug" "$id" "$step" "$title" "$raw_ref" "$record_ref"
  log_info "cleared $id"
done
