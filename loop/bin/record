#!/usr/bin/env bash
# Validate the artifact a step wrote and commit its lifecycle event. This is
# the only way an event reaches index.jsonl: bash — not the agent that wrote
# the artifact — decides whether the step counts as done.
#
# Usage: loop/bin/record <workspace-name> <request-id> <step>
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/record <workspace-name> <request-id> <step>

Checks the file that step was told to write against the frontmatter
loop/bin/step handed it, then appends the step's event to index.jsonl.

On failure nothing is recorded, a per-key actual-vs-expected dump goes to
stderr, and the artifact is left on disk to inspect or overwrite — rerun the
step, then run this again.

For a step that takes the working tree (implement, verify, decide) the
request must still hold the workspace's exclusive-phase lock — the lock is
what loop/bin/step granted it. Recording does not release it: the rest of
that phase inherits the same claim. Recording a `decide` whose route is not
`commit` clears the claim's recorded steps, so the request may take another
implement/verify/decide lap on the same tree.

Exit codes: 0 recorded, 1 validation/general failure, 2 workspace not found,
3 the exclusive phase is not held by this request.
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

require_cmd jq

[ $# -eq 3 ] || { usage; exit 1; }
name=$1
id=$2
step=$3

validate_workspace_name "$name"
slug=$(slugify "$name")
require_step "$step"

# A step that takes the working tree must still hold the claim loop/bin/step
# granted it. Without that, this artifact was not produced by the loop's own
# dispatch — or another request has since been let into the phase — and either
# way it must not become the record of what happened.
if step_is_exclusive "$step"; then
  held=$(impl_lock_holder "$slug")
  if [ "$held" != "$id" ]; then
    die "'$step' for $id was not recorded: ${held:-nobody} holds the exclusive phase for '$name'
Start it properly first:
  $LOOP_BIN_DIR/step $name $id $step" 3
  fi
fi

artifact_validate "$slug" "$name" "$id" "$step" \
  || die "'$step' for $id was not recorded — see the mismatches above" 1

file=$(artifact_path "$slug" "$step" "$id")
at=$(record_frontmatter_get "$file" "$(step_field "$step" 5)")
status=$(step_field "$step" 4)
record_ref=$(artifact_ref "$slug" "$step" "$id")
raw_ref=$(artifact_ref "$slug" raw "$id")

# The title is the request's own, for every step: it names the request in
# `loop/bin/list`, and a later step's heading describes that step, not the work.
title=$(record_title "$(artifact_path "$slug" request "$id")")
[ -n "$title" ] || title="(untitled)"

# `request` is the event that brings a request into existence; everything after
# it completes a step of one that already exists.
event=completed
[ "$step" = request ] && event=created

append_event "$slug" "$id" "$at" "$step" "$event" "$status" "$title" "$raw_ref" "$record_ref"

# Note it against the claim, so the same step cannot run twice under it: that
# is what keeps implement -> verify -> decide in order inside one lap.
route=""
if step_is_exclusive "$step"; then
  impl_lock_mark "$slug" "$step"
fi

# `decide` is what turns the cycle. Every route but `commit` sends this request
# back into the phase for another lap, so the claim's marks are wiped and the
# same steps may run again — while the holder stays, because the working tree
# is still dirty and still this request's. `commit` keeps the marks: the phase
# is being handed on, and until `commit` exists a rerun of `decide` must stay
# refused rather than quietly re-judging work already judged.
if [ "$step" = decide ]; then
  route=$(record_frontmatter_get "$file" route)
  [ "$route" = commit ] || impl_lock_clear_marks "$slug"
fi

jq -n \
  --arg id "$id" --arg step "$step" --arg status "$status" \
  --arg title "$title" --arg ref "$record_ref" --arg route "$route" \
  '{recorded:true, id:$id, step:$step, status:$status, title:$title, ref:$ref}
   + (if $route == "" then {} else {route:$route} end)'
