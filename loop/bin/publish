#!/usr/bin/env bash
# Act on an approved review: push the request's branch to origin, or — in a repo
# with no remote — merge it into the trunk.
#
# This is deliberately the last step the loop takes. `implement` writes the
# code, `land` commits it to a local branch, `review` audits that branch and
# puts it in front of a human — and only if they approved it does this run. A
# rejected review publishes nothing, so a bad run costs a local branch delete
# rather than something somebody has to be told to ignore.
#
# **What "publish" means depends on whether there is anywhere to push.**
#
#   with an origin     push the branch. The loop stops there: opening the pull
#                      request, and merging it, are a human's to do on whichever
#                      forge the remote lives on. The loop has no opinion about
#                      which one that is, and needs no credentials for it beyond
#                      the ssh key the operator generates in settings.
#
#   no origin          merge the branch into the trunk, here. A pull request
#                      needs a forge and there isn't one; the human's approval is
#                      still the gate, and merging is what it now opens. The
#                      merge never touches the working tree — see
#                      git_merge_into_trunk — because by now another request may
#                      hold it.
#
# Either way the request ends up `published`, which is the state the overseer
# reads, and `close` ends it once the work is on the trunk.
#
# The `pr_title` and `## PR body` the `commit` step wrote are kept in both
# worlds: they are the description a human pastes when they open the pull
# request, or the briefing for the merge when there is none.
#
# Usage: loop/bin/publish <workspace-name> <request-id> [--dry-run] [--force]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/publish <workspace-name> <request-id> [--dry-run] [--force]

Acts on an approved review. With an `origin` remote, pushes that request's
branch there and prints the title its commit record carries, for the pull
request you open yourself. With no remote, merges the branch into the trunk
instead — there is no forge to open a pull request on, and the approval is what
lands the work.

Refused until the request has a recorded `review` whose outcome is `approved`
or `followups`. Nothing about a request goes anywhere before a human has looked
at it and said yes — that is the whole reason this is a separate verb from
loop/bin/land rather than the end of it.

Work already done is skipped — a remote branch already at this sha, a branch
already contained in the trunk — so an interrupted run is retried by running it
again. Appends a `published` event either way.

--dry-run  print the exact commands and change nothing
--force    publish without a review. For a human who means it; the refusal
           exists to stop the loop doing it on its own, not to stop you.

Exit codes: 0 ok, 1 general/validation failure, 2 workspace not found,
3 the request has not been reviewed, or its review rejected the work,
4 not a git repository, or no trunk branch.
USAGE
}

require_cmd jq
require_cmd git

name="" id="" dry=0 force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --force)   force=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" 1 ;;
    *)
      if [ -z "$name" ]; then name=$1
      elif [ -z "$id" ]; then id=$1
      else die "unexpected extra argument: $1" 1
      fi
      shift
      ;;
  esac
done

[ -n "$name" ] && [ -n "$id" ] || { usage; exit 1; }

repo=$(resolve_workspace "$name")
slug=$(slugify "$name")
git_require_repo "$repo" "$name"

event=$(request_event "$slug" "$id")
[ -n "$event" ] || die "no request '$id' found for '$name'" 1

# --- the gate ------------------------------------------------------------
# The review record is the authority, not the overseer's recollection of it.
review_file=$(artifact_path "$slug" review "$id")
outcome=$(record_frontmatter_get "$review_file" outcome)
if [ "$force" -ne 1 ]; then
  case "$outcome" in
    approved|followups) ;;
    rejected)
      die "the review of $id rejected this work — nothing is published
Its branch stays where it is and stays in the train, so follow-up requests are
cut off it. Publish only what a human approved:
  $LOOP_BIN_DIR/list $name --json" 3
      ;;
    "")
      die "$id has not been reviewed — nothing is published
A request's work stays on this machine until a human has audited it and said
yes. Review it first:
  $LOOP_BIN_DIR/step $name $id review
If you mean to push it anyway, say so:
  $LOOP_BIN_DIR/publish $name $id --force" 3
      ;;
    *) die "the review of $id carries an outcome this command cannot act on: '$outcome'" 1 ;;
  esac
fi

branch=$(git_request_branch "$repo" "$id")
[ -n "$branch" ] || die "request $id has no branch to publish
  $LOOP_BIN_DIR/train $name" 1
base=$(git_base_ref "$repo" "$branch")
trunk=$(git_require_default_ref "$repo" "$name")

file=$(artifact_path "$slug" commit "$id")
[ -f "$file" ] || die "no commit record at $(artifact_ref "$slug" commit "$id")" 1
pr_title=$(record_frontmatter_get "$file" pr_title)
pr_body=$(record_section "$file" "PR body")
[ -n "$pr_title" ] || die "the commit record has no pr_title" 1
[ -n "$pr_body" ] || die "the commit record has no '## PR body' section" 1

sha=$(git_ws "$repo" rev-parse "$branch")
merged=false
merge_result=""

if [ "$dry" -eq 1 ]; then
  log_info "would run, in $name:"
  if git_has_origin "$repo"; then
    printf '  git push -u origin %s\n' "$branch"
  else
    printf '  # no origin remote — merge %s into %s instead\n' "$branch" "${trunk#origin/}"
  fi
  exit 0
fi

if git_has_origin "$repo"; then
  # --- push --------------------------------------------------------------
  if [ "$(git_ws "$repo" rev-parse --quiet --verify "refs/remotes/origin/$branch" 2>/dev/null)" = "$sha" ]; then
    log_info "already pushed: origin/$branch is at $(git_ws "$repo" rev-parse --short "$branch")"
  else
    git_ws "$repo" push --quiet -u origin "$branch"
    log_info "pushed $branch to origin"
  fi

  # --- the stacked base --------------------------------------------------
  # The base is pushed too when it is another request's branch. A stacked
  # request is the normal case rather than the exception, and a human opening
  # the pull request needs the branch it targets to exist on origin —
  # otherwise the forge offers only the default branch and the diff is
  # everything, not this request.
  #
  # The test is the loop's own metadata, not the shape of the name: a base with
  # no `looprequest` key is the trunk, which is the forge's business and never
  # ours to push.
  if [ -n "$(git_branch_meta "$repo" "$base" "$LOOP_GIT_KEY_REQUEST")" ] \
    && ! git_ws "$repo" rev-parse --quiet --verify "refs/remotes/origin/$base" >/dev/null 2>&1; then
    log_info "base '$base' is not on origin yet — pushing it so the pull request has something to target"
    git_ws "$repo" push --quiet -u origin "$base"
  fi

  log_info "open the pull request on your forge: $branch → ${base#origin/}"
  log_info "title: $pr_title"
else
  # --- merge -------------------------------------------------------------
  # No remote, so there is nothing to push and no forge to open a pull request
  # on. The approval merges the work into the trunk instead. The working tree
  # is left exactly as it was: another request may already hold it.
  merge_result=$(git_merge_into_trunk "$repo" "$branch" "$trunk")
  merged=true
  case "$merge_result" in
    already) log_info "'$branch' is already contained in ${trunk#origin/} — nothing to merge" ;;
    *)       log_info "merged $branch into ${trunk#origin/} ($merge_result) — this repo has no origin, so nothing was pushed" ;;
  esac
  log_info "end it when you are ready: $LOOP_BIN_DIR/close $name $id"
fi

title=$(printf '%s' "$event" | jq -r '.title')
append_event "$slug" "$id" "$(iso_now)" review published published "$title" \
  "$(artifact_ref "$slug" raw "$id")" "$(artifact_ref "$slug" review "$id")"

jq -n --arg id "$id" --arg branch "$branch" --arg base "$base" \
  --arg sha "$sha" --arg trunk "${trunk#origin/}" \
  --argjson merged "$merged" --arg merge "$merge_result" \
  '{published:true, id:$id, branch:$branch, base:$base, sha:$sha,
    trunk:$trunk, merged:$merged}
   + (if $merged then {merge:$merge} else {} end)'
