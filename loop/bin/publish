#!/usr/bin/env bash
# Push a reviewed request's branch and open its pull request.
#
# This is the first moment anything about a request leaves this machine, and it
# is deliberately the last step before merging. `implement` writes the code,
# `land` commits it to a local branch, `review` audits that branch and puts it
# in front of a human — and only if they approved it does this run. A rejected
# review pushes nothing, so a bad run costs a local branch delete rather than a
# public pull request somebody has to be told to ignore.
#
# The pull-request title and body were written by the `commit` step, long
# before anyone approved anything. That is fine: writing them is free and
# opening the pull request is what is public.
#
# Usage: loop/bin/publish <workspace-name> <request-id> [--dry-run] [--force]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/publish <workspace-name> <request-id> [--dry-run] [--force]

Pushes that request's branch to origin and opens a pull request against the
branch it was cut from, using the title and body its commit record carries.

Refused until the request has a recorded `review` whose outcome is `approved`
or `followups`. Nothing about a request is public before a human has looked at
it and said yes — that is the whole reason this is a separate verb from
loop/bin/land rather than the end of it.

Both stages are skipped when they have already happened — a remote branch
already at this sha, a pull request already open — so an interrupted run is
retried by running it again. Appends a `published` event carrying the pull
request's url.

--dry-run  print the exact commands and change nothing
--force    publish without a review. For a human who means it; the refusal
           exists to stop the loop doing it on its own, not to stop you.

Exit codes: 0 ok, 1 general/validation failure, 2 workspace not found,
3 the request has not been reviewed, or its review rejected the work,
4 not a git repository, or no origin remote,
6 gh is missing or not authenticated.
USAGE
}

require_cmd jq
require_cmd git

name="" id="" dry=0 force=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --force)   force=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" 1 ;;
    *)
      if [ -z "$name" ]; then name=$1
      elif [ -z "$id" ]; then id=$1
      else die "unexpected extra argument: $1" 1
      fi
      shift
      ;;
  esac
done

[ -n "$name" ] && [ -n "$id" ] || { usage; exit 1; }

repo=$(resolve_workspace "$name")
slug=$(slugify "$name")
git_require_repo "$repo" "$name"

event=$(request_event "$slug" "$id")
[ -n "$event" ] || die "no request '$id' found for '$name'" 1

# --- the gate ------------------------------------------------------------
# The review record is the authority, not the overseer's recollection of it.
review_file=$(artifact_path "$slug" review "$id")
outcome=$(record_frontmatter_get "$review_file" outcome)
if [ "$force" -ne 1 ]; then
  case "$outcome" in
    approved|followups) ;;
    rejected)
      die "the review of $id rejected this work — nothing is published
Its branch stays where it is and stays in the train, so follow-up requests are
cut off it. Publish only what a human approved:
  $LOOP_BIN_DIR/list $name --json" 3
      ;;
    "")
      die "$id has not been reviewed — nothing is published
A request's work stays on this machine until a human has audited it and said
yes. Review it first:
  $LOOP_BIN_DIR/step $name $id review
If you mean to push it anyway, say so:
  $LOOP_BIN_DIR/publish $name $id --force" 3
      ;;
    *) die "the review of $id carries an outcome this command cannot act on: '$outcome'" 1 ;;
  esac
fi

branch=$(git_request_branch "$repo" "$id")
[ -n "$branch" ] || die "request $id has no branch to publish
  $LOOP_BIN_DIR/train $name" 1
base=$(git_base_ref "$repo" "$branch")

file=$(artifact_path "$slug" commit "$id")
[ -f "$file" ] || die "no commit record at $(artifact_ref "$slug" commit "$id")" 1
pr_title=$(record_frontmatter_get "$file" pr_title)
pr_body=$(record_section "$file" "PR body")
[ -n "$pr_title" ] || die "the commit record has no pr_title" 1
[ -n "$pr_body" ] || die "the commit record has no '## PR body' section" 1

command -v gh >/dev/null 2>&1 || die "gh is not on PATH
The loop opens the pull request itself rather than leaving one for you to
remember, so this needs the GitHub CLI:
  https://cli.github.com" 6
gh auth status >/dev/null 2>&1 || die "gh is not authenticated
  gh auth login" 6

# Check gh can actually reach this repository *before* pushing anything. The
# push and the pull request are one intention, and finding out only after the
# push that gh cannot see the remote leaves a branch on origin with nothing
# attached to explain it — a public artefact of a failure, which is the one
# thing this whole command is arranged to avoid.
(cd "$repo" && gh repo view --json name >/dev/null 2>&1) || die "gh cannot see the repository behind origin
  $(git_ws "$repo" remote get-url origin)
Nothing has been pushed. Either origin does not point at a GitHub host gh knows
about, or your token cannot read it:
  gh auth status
  gh auth login --hostname <host>" 6

sha=$(git_ws "$repo" rev-parse "$branch")

if [ "$dry" -eq 1 ]; then
  log_info "would run, in workspace/$name:"
  printf '  git push -u origin %s\n' "$branch"
  printf "  gh pr create --base %s --head %s --title '%s' --body-file -\n" \
    "${base#origin/}" "$branch" "$pr_title"
  exit 0
fi

# --- push ----------------------------------------------------------------
if [ "$(git_ws "$repo" rev-parse --quiet --verify "refs/remotes/origin/$branch" 2>/dev/null)" = "$sha" ]; then
  log_info "already pushed: origin/$branch is at $(git_ws "$repo" rev-parse --short "$branch")"
else
  git_ws "$repo" push --quiet -u origin "$branch"
  log_info "pushed $branch to origin"
fi

# --- pull request --------------------------------------------------------
# The base is pushed too when it is another request's branch: GitHub cannot
# open a pull request against a branch it has never seen, and a stacked request
# is the normal case rather than the exception.
if [ "$base" != "${base#origin/}" ]; then
  : # already a remote-tracking ref — the default branch, nothing to do
elif ! git_ws "$repo" rev-parse --quiet --verify "refs/remotes/origin/$base" >/dev/null 2>&1; then
  log_info "base '$base' is not on origin yet — pushing it so the pull request has something to target"
  git_ws "$repo" push --quiet -u origin "$base"
fi

pr_url=$(git_branch_meta "$repo" "$branch" "$LOOP_GIT_KEY_PR")
if [ -z "$pr_url" ]; then
  pr_url=$(cd "$repo" && gh pr view "$branch" --json url --jq '.url' 2>/dev/null || true)
fi
if [ -n "$pr_url" ]; then
  log_info "pull request already open: $pr_url"
else
  pr_url=$(printf '%s\n' "$pr_body" | (cd "$repo" && gh pr create \
    --base "${base#origin/}" --head "$branch" --title "$pr_title" --body-file -))
  log_info "opened $pr_url"
fi
git_set_branch_meta "$repo" "$branch" "$LOOP_GIT_KEY_PR" "$pr_url"

title=$(printf '%s' "$event" | jq -r '.title')
append_event "$slug" "$id" "$(iso_now)" review published published "$title" \
  "$(artifact_ref "$slug" raw "$id")" "$(artifact_ref "$slug" review "$id")"

jq -n --arg id "$id" --arg branch "$branch" --arg base "$base" \
  --arg sha "$sha" --arg pr "$pr_url" \
  '{published:true, id:$id, branch:$branch, base:$base, sha:$sha, pr:$pr}'
