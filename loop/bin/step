#!/usr/bin/env bash
# Print the context for one step of one request: every path, ref, and
# frontmatter value that step needs, named. Nearly pure — it creates the slug's
# directories, and for a step that takes the working tree it claims the
# workspace's exclusive-phase lock before handing the context over.
#
# Usage: loop/bin/step <workspace-name> <request-id> <step> [--tracer <ids>]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/step <workspace-name> <request-id> <step> [--tracer <ids>]

Prints, as JSON on stdout, everything needed to run one step of one request:
the instruction file to follow, the input artifacts to read, the file to
write, and the exact frontmatter to put in it.

Copy `frontmatter` into the written file verbatim; supply the keys listed in
`frontmatter_open` yourself. `loop/bin/record` checks the result against the
same values, so anything altered here is rejected there.

--tracer  the slice of the plan to work, for a step that takes the working
          tree (implement, verify, decide). Takes one tracer id, a
          comma-separated list, or the flag repeated — several ids mean the
          plan declared them parallel, so one run does the whole group.
          `loop/bin/tracers <ws> <id> --next` prints exactly what to pass.
          Omit it and the step picks the next pending group itself. Those
          steps also claim the workspace's exclusive-phase lock here: one
          request owns the working tree at a time, and loop/bin/phase
          hands it on.

Exit codes: 0 ok, 1 general/validation failure, 2 workspace not found,
3 the exclusive phase is unavailable — another request holds it, or this
  request has already recorded this step on the current lap of the cycle.
USAGE
}

require_cmd jq

name="" id="" step="" tracers="" held="" onward=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --tracer)
      [ $# -ge 2 ] || die "--tracer needs a tracer id" 1
      # Repeatable and comma-separated both land in the same list, so the
      # caller can use whichever reads better where it is written.
      tracers="${tracers:+$tracers,}$2"
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" 1 ;;
    *) args+=("$1"); shift ;;
  esac
done

[ ${#args[@]} -eq 3 ] || { usage; exit 1; }
name=${args[0]}
id=${args[1]}
step=${args[2]}

workspace_dir=$(resolve_workspace "$name")
slug=$(slugify "$name")
require_step "$step"
ensure_slug_dirs "$slug"

if step_is_exclusive "$step"; then
  # This step has already recorded under the claim this request still holds, so
  # the phase has moved on: implement -> verify -> decide runs in that order,
  # and running one of them twice on the same lap would either stack a second
  # unjudged change on the first or re-judge work already judged. `decide`
  # clears the marks when it routes the request back for another lap, which is
  # what makes the next `implement` legal again.
  # Only a run that actually recorded trips this: the marker is written by
  # loop/bin/record and lives on the claim, so a run whose record failed can
  # still be retried, and releasing the phase clears the slate.
  if [ "$(impl_lock_holder "$slug")" = "$id" ] && impl_lock_recorded "$slug" "$step"; then
    onward=$(next_exclusive_step "$step")
    if [ "$onward" = commit ]; then
      die "'$step' has already run for $id, and it routed the request to 'commit'
'commit' is not built, so nothing can take the work from here — the loop for
'$name' is halted at the end of the cycle by design, not blocked on something
you can retry. $LOOP_BIN_DIR/phase $name reports the state; clearing the
request is what ends it." 3
    fi
    die "'$step' has already recorded for $id — '$onward' is what comes next
Each of $LOOP_EXCLUSIVE_STEPS runs once per lap of the cycle, in that order:
  $LOOP_BIN_DIR/step $name $id $onward
Rerun '$step' only after 'decide' has routed this request back for another
lap. $LOOP_BIN_DIR/phase $name reports the state." 3
  fi
  if ! held=$(impl_lock_claim "$slug" "$id" 2>&1); then
    die "request $held already holds the exclusive phase for '$name'
Only one request at a time may run $LOOP_EXCLUSIVE_STEPS, so two of them
cannot edit the same working tree. Finish or hand the phase on first:
  $LOOP_BIN_DIR/phase $name --release" 3
  fi
elif [ -n "$tracers" ]; then
  die "--tracer applies only to $LOOP_EXCLUSIVE_STEPS, not '$step'" 1
fi

step_context_json "$name" "$slug" "$id" "$step" "$workspace_dir" "$(iso_now)" "$tracers"
