#!/usr/bin/env bash
# Show or select the active loop provider. Writes the choice to
# loop/.provider (LOOP_PROVIDER still overrides at runtime when set).
#
# Usage: loop/bin/provider [<id>]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/providers.sh"

usage() {
  cat >&2 <<'EOF'
usage: loop/bin/provider [<id>]

Lists available providers under loop/providers/ and the currently selected
one (from loop/.provider, ignoring LOOP_PROVIDER).

With no <id> and a TTY, prompts for a numbered selection and writes
loop/.provider. With <id>, sets that provider directly. Without a TTY and
without <id>, prints the list and exits 1.

Exit codes: 0 ok, 1 usage/validation failure.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

ids=()
while IFS= read -r id; do
  [ -n "$id" ] || continue
  ids+=("$id")
done < <(list_provider_ids)

if [ ${#ids[@]} -eq 0 ]; then
  die "no providers found under $LOOP_DIR/providers" 1
fi

# Current tracked default only — not LOOP_PROVIDER, so the menu reflects
# what .provider would use on the next run without an env override.
current=""
if [ -f "$LOOP_DIR/.provider" ]; then
  current=$(tr -d '[:space:]' < "$LOOP_DIR/.provider")
fi
[ -n "$current" ] || current="claude-code"

print_list() {
  local i=1 id mark
  printf 'Available providers:\n'
  for id in "${ids[@]}"; do
    mark=" "
    [ "$id" = "$current" ] && mark="*"
    printf '  %s %d) %s\n' "$mark" "$i" "$id"
    i=$((i + 1))
  done
  printf 'Current: %s (loop/.provider)\n' "$current"
  if [ -n "${LOOP_PROVIDER:-}" ]; then
    log_info "LOOP_PROVIDER=$LOOP_PROVIDER is set and overrides .provider at runtime"
  fi
}

choose_interactive() {
  local choice
  print_list
  printf '\nSelect provider [1-%d] (empty cancels): ' "${#ids[@]}" >&2
  IFS= read -r choice || true
  if [ -z "${choice:-}" ]; then
    log_info "cancelled — still using '$current'"
    exit 0
  fi
  if ! [[ "$choice" =~ ^[1-9][0-9]*$ ]] || [ "$choice" -gt "${#ids[@]}" ]; then
    die "invalid selection: $choice" 1
  fi
  printf '%s\n' "${ids[$((choice - 1))]}"
}

if [ $# -gt 1 ]; then
  usage
  exit 1
fi

if [ $# -eq 1 ]; then
  case "$1" in
    -*)
      die "unknown option: $1" 1
      ;;
  esac
  selected=$1
else
  if [ -t 0 ] && [ -t 1 ]; then
    selected=$(choose_interactive)
  else
    print_list
    die "pass a provider id, or run from a TTY to select interactively" 1
  fi
fi

set_provider_id "$selected"
log_info "provider set to '$selected' (loop/.provider)"
if [ -n "${LOOP_PROVIDER:-}" ] && [ "$LOOP_PROVIDER" != "$selected" ]; then
  log_info "note: LOOP_PROVIDER=$LOOP_PROVIDER still overrides until unset"
fi
