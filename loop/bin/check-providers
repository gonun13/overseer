#!/usr/bin/env bash
# Isolation lint for loop/ provider bundles. Fail if provider-specific
# CLIs or config paths leak into orchestration (or into another provider's
# bundle). Run from anywhere; resolves paths via common.sh.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"

fail=0
err() {
  printf 'check-providers: %s\n' "$*" >&2
  fail=1
}

CONTRACT_FNS=(provider_check_available provider_structure provider_research provider_scope provider_plan provider_pick_plan)
STEP_COMMANDS=(structure-request.md research-request.md scope-request.md plan-request.md pick-plan-request.md)

# Strip comments and string refs to Overseer's packages/adapters/claude-code
# so a path mention of that TS package is not treated as a CLI leak.
scrub() {
  sed -E \
    -e 's/#.*$//' \
    -e 's|packages/adapters/claude-code[^[:space:]]*||g' \
    "$1"
}

# True if scrubbed content still has a bare "claude" token (CLI / .claude),
# not only the provider id "claude-code".
has_claude_leak() {
  local content
  content=$(scrub "$1")
  # Drop the allowed default provider id token, then look for remaining hits.
  content=$(printf '%s' "$content" | sed -E 's/claude-code//g')
  printf '%s' "$content" | grep -Eiq 'claude|\.claude'
}

# --- 1. Orchestration must not name a specific provider CLI or its assets ---
orchestration_files=(
  "$LOOP_DIR/run"
  "$LOOP_BIN_DIR/list"
  "$LOOP_BIN_DIR/clear"
  "$LOOP_BIN_DIR/provider"
  "$LOOP_BIN_DIR/lib/providers.sh"
  "$LOOP_BIN_DIR/lib/common.sh"
  "$LOOP_BIN_DIR/lib/db.sh"
  "$LOOP_BIN_DIR/lib/steps.sh"
)
while IFS= read -r f; do
  orchestration_files+=("$f")
done < <(find "$LOOP_BIN_DIR/lib/steps" -type f -name '*.sh' 2>/dev/null | sort)

for f in "${orchestration_files[@]}"; do
  [ -f "$f" ] || continue
  if has_claude_leak "$f"; then
    err "provider-specific token in orchestration: ${f#"$LOOP_DIR"/}"
  fi
  # Specific CLI binary names that must stay inside provider bundles.
  if scrub "$f" | sed -E 's/claude-code//g' | grep -Eiq '(^|[^[:alnum:]_-])(claude|agent)([^[:alnum:]_-]|$)'; then
    err "provider CLI name in orchestration: ${f#"$LOOP_DIR"/}"
  fi
done

# --- 2. Non-claude-code bundles must not contain claude-code assets ---
while IFS= read -r bundle; do
  id=$(basename "$bundle")
  [ "$id" = "claude-code" ] && continue
  while IFS= read -r f; do
    case "$f" in
      *.md) continue ;; # docs may mention other providers by name
    esac
    # Shared step command stems (structure-request, …) are allowed; only
    # Claude CLI / .claude/ config paths are leaks. Mentions of the
    # provider id "claude-code" are fine.
    if scrub "$f" | sed -E 's/claude-code//g' | grep -Eiq 'claude|\.claude'; then
      err "claude-code leak in provider '$id': ${f#"$LOOP_DIR"/}"
    fi
  done < <(find "$bundle" -type f 2>/dev/null | sort)
done < <(find "$LOOP_DIR/providers" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)

# --- 3. Every bundle defines the full contract ---
while IFS= read -r bundle; do
  id=$(basename "$bundle")
  script="$bundle/provider.sh"
  manifest="$bundle/manifest"
  [ -f "$manifest" ] || err "provider '$id' missing manifest"
  [ -f "$script" ] || { err "provider '$id' missing provider.sh"; continue; }
  for fn in "${CONTRACT_FNS[@]}"; do
    grep -Eq "^${fn}\\(\\)" "$script" || err "provider '$id' missing function $fn"
  done
done < <(find "$LOOP_DIR/providers" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)

# --- 4. claude-code bundle has the slash-command files ---
cc="$LOOP_DIR/providers/claude-code"
for cmd in "${STEP_COMMANDS[@]}"; do
  [ -f "$cc/.claude/commands/$cmd" ] || err "claude-code missing .claude/commands/$cmd"
done
[ -f "$cc/manifest" ] || err "claude-code missing manifest"
[ -f "$cc/provider.sh" ] || err "claude-code missing provider.sh"

# --- 5. cursor bundle has commands + cli.json ---
cur="$LOOP_DIR/providers/cursor"
for cmd in "${STEP_COMMANDS[@]}"; do
  [ -f "$cur/.cursor/commands/$cmd" ] || err "cursor missing .cursor/commands/$cmd"
done
[ -f "$cur/.cursor/cli.json" ] || err "cursor missing .cursor/cli.json"
[ -f "$cur/manifest" ] || err "cursor missing manifest"
[ -f "$cur/provider.sh" ] || err "cursor missing provider.sh"
if [ -f "$cur/manifest" ] && ! grep -Eq '^PROVIDER_CLI=agent$' "$cur/manifest"; then
  err "cursor manifest must set PROVIDER_CLI=agent"
fi

if [ "$fail" -ne 0 ]; then
  printf 'check-providers: FAILED\n' >&2
  exit 1
fi

printf 'check-providers: ok\n'
exit 0
