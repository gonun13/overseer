#!/usr/bin/env bash
# List open (not cleared) requests and their current step/status, derived from
# db/<slug>/index.jsonl — no separate state cache, per the README.
#
# Usage: loop/bin/list [workspace-name] [--json]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/list [workspace-name] [--json]

Lists open requests (any request not yet cleared) and their current
step/status. With a workspace-name, lists only that workspace's slug;
without one, lists every slug under db/.

--json  one object per workspace: {slug, session, lock, requests: [...]}.
        `session` is the overseer session currently driving that workspace
        (null if none); `lock` is the id of the request that owns the working
        tree while it runs implement/verify/decide/commit (null if none) — no
        other request may enter that phase until loop/bin/land hands it back.
        A request whose latest step is `decide` also carries `route`: where
        that decision sent it, and one whose latest step is `review` carries
        `outcome` — which is the whole of how the next action survives a
        restart. Every request that owns a branch also carries `branch`:
        {name, base, pr, state}, so the train is visible without running git.
        This is the form to read from a script or an agent.

Exit codes: 0 ok, 1 general failure.
USAGE
}

require_cmd jq

# event_route <slug> <event-json> — the route a `decide` event sent the request
# on, read from that record's frontmatter. Empty for every other step. This is
# the one place `list` opens an artifact: the route is a routing instruction,
# not content, and reading it here is what keeps the overseer from having to
# open the decision record itself.
event_route() {
  local slug=$1 event=$2 step id
  step=$(printf '%s' "$event" | jq -r '.step')
  [ "$step" = decide ] || return 0
  id=$(printf '%s' "$event" | jq -r '.id')
  record_frontmatter_get "$(artifact_path "$slug" decide "$id")" route
}

# event_outcome <slug> <event-json> — the outcome a `review` recorded. Same
# argument as event_route: an outcome is an instruction about what happens
# next, not content, so reading it here is what keeps the overseer from opening
# the review record itself.
event_outcome() {
  local slug=$1 event=$2 step id
  step=$(printf '%s' "$event" | jq -r '.step')
  [ "$step" = review ] || return 0
  id=$(printf '%s' "$event" | jq -r '.id')
  record_frontmatter_get "$(artifact_path "$slug" review "$id")" outcome
}

# event_branch <slug> <workspace-dir> <event-json> — that request's place in
# the train as a JSON object, or `null`. Empty when the workspace directory is
# gone or is not a git repo, so `list` keeps working for a project that has
# been deleted out from under its records.
event_branch() {
  local slug=$1 repo=$2 event=$3 id branch base state default_ref
  [ -n "$repo" ] && [ -d "$repo" ] || { printf 'null'; return 0; }
  git_is_repo "$repo" || { printf 'null'; return 0; }
  id=$(printf '%s' "$event" | jq -r '.id')
  branch=$(git_request_branch "$repo" "$id")
  [ -n "$branch" ] || { printf 'null'; return 0; }
  default_ref=$(git_default_ref "$repo") || default_ref=""
  state=live
  if [ -n "$default_ref" ] && git_branch_landed "$repo" "$branch" "$default_ref"; then
    state=landed
  fi
  base=$(git_branch_meta "$repo" "$branch" "$LOOP_GIT_KEY_BASE")
  jq -nc --arg n "$branch" --arg b "$base" --arg state "$state" \
    --arg pr "$(git_branch_meta "$repo" "$branch" "$LOOP_GIT_KEY_PR")" \
    '{name:$n, base:(if $b == "" then null else $b end),
      pr:(if $pr == "" then null else $pr end), state:$state}'
}

# workspace_dir_of <slug-or-name> — the project directory if it still exists,
# empty otherwise. `list` deliberately does not require one (a cleared-up
# project still has records worth listing), so this never dies.
workspace_dir_of() {
  local dir="$WORKSPACE_ROOT/$1"
  [ -d "$dir" ] && printf '%s' "$dir"
  return 0
}

name="" as_json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) as_json=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" 1 ;;
    *)
      [ -z "$name" ] || die "unexpected extra argument: $1" 1
      name=$1
      shift
      ;;
  esac
done

slugs=()
if [ -n "$name" ]; then
  validate_workspace_name "$name"
  slugs=("$(slugify "$name")")
else
  while IFS= read -r d; do
    slugs+=("$(basename "$d")")
  done < <(find "$LOOP_DIR/db" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
fi

if [ "$as_json" -eq 1 ]; then
  for slug in "${slugs[@]}"; do
    session=$(running_get "$slug" || true)
    [ -n "$session" ] || session=null
    held=$(impl_lock_holder "$slug" || true)
    repo=$(workspace_dir_of "$slug")
    while IFS= read -r event; do
      [ -n "$event" ] || continue
      printf '%s' "$event" | jq -c --arg route "$(event_route "$slug" "$event")" \
        --arg outcome "$(event_outcome "$slug" "$event")" \
        --argjson branch "$(event_branch "$slug" "$repo" "$event")" \
        '. + {route: (if $route == "" then null else $route end),
              outcome: (if $outcome == "" then null else $outcome end),
              branch: $branch}'
    done < <(open_request_events "$slug") \
      | jq -s --arg slug "$slug" --argjson session "$session" --arg lock "$held" \
          '{slug:$slug, session:$session,
            lock:(if $lock == "" then null else $lock end),
            requests:.}'
  done
  exit 0
fi

if [ ${#slugs[@]} -eq 0 ]; then
  log_info "no requests recorded yet"
  exit 0
fi

found=0
for slug in "${slugs[@]}"; do
  session=$(running_get "$slug" || true)
  if [ -n "$session" ]; then
    log_info "overseer session on [$slug]: pid $(printf '%s' "$session" | jq -r '.pid'), since $(printf '%s' "$session" | jq -r '.started_at')"
  fi
  held=$(impl_lock_holder "$slug" || true)
  if [ -n "$held" ]; then
    log_info "exclusive phase on [$slug]: held by $held"
  fi
  while IFS= read -r event; do
    [ -n "$event" ] || continue
    if [ "$found" -eq 0 ]; then
    printf '%-32s %-14s %-10s %-22s %-21s %s\n' ID SLUG STEP STATUS UPDATED TITLE
    fi
    found=1
    route=$(event_route "$slug" "$event")
    printf '%-32s %-14s %-10s %-22s %-21s %s\n' \
      "$(printf '%s' "$event" | jq -r '.id')" \
      "$slug" \
      "$(printf '%s' "$event" | jq -r '.step')" \
      "$(printf '%s' "$event" | jq -r '.status')${route:+ (→$route)}" \
      "$(printf '%s' "$event" | jq -r '.at')" \
      "$(printf '%s' "$event" | jq -r '.title')"
  done < <(open_request_events "$slug")
done

[ "$found" -eq 1 ] || log_info "no open requests"
