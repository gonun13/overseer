#!/usr/bin/env bash
# List open (not cleared) requests and their current step/status, derived from
# db/<slug>/index.jsonl — no separate state cache, per the README.
#
# Usage: loop/bin/list [workspace-name] [--json]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/list [workspace-name] [--json]

Lists open requests (any request not yet cleared) and their current
step/status. With a workspace-name, lists only that workspace's slug;
without one, lists every slug under db/.

--json  one object per workspace: {slug, session, lock, requests: [...]}.
        `session` is the overseer session currently driving that workspace
        (null if none); `lock` is the id of the request that owns the working
        tree while it runs implement/verify/decide (null if none) — no other
        request may enter that phase until it is released. A request whose
        latest step is `decide` also carries `route`: where that decision sent
        it, which is the whole of how the next action survives a restart. This
        is the form to read from a script or an agent.

Exit codes: 0 ok, 1 general failure.
USAGE
}

require_cmd jq

# event_route <slug> <event-json> — the route a `decide` event sent the request
# on, read from that record's frontmatter. Empty for every other step. This is
# the one place `list` opens an artifact: the route is a routing instruction,
# not content, and reading it here is what keeps the overseer from having to
# open the decision record itself.
event_route() {
  local slug=$1 event=$2 step id
  step=$(printf '%s' "$event" | jq -r '.step')
  [ "$step" = decide ] || return 0
  id=$(printf '%s' "$event" | jq -r '.id')
  record_frontmatter_get "$(artifact_path "$slug" decide "$id")" route
}

name="" as_json=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) as_json=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" 1 ;;
    *)
      [ -z "$name" ] || die "unexpected extra argument: $1" 1
      name=$1
      shift
      ;;
  esac
done

slugs=()
if [ -n "$name" ]; then
  validate_workspace_name "$name"
  slugs=("$(slugify "$name")")
else
  while IFS= read -r d; do
    slugs+=("$(basename "$d")")
  done < <(find "$LOOP_DIR/db" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
fi

if [ "$as_json" -eq 1 ]; then
  for slug in "${slugs[@]}"; do
    session=$(running_get "$slug" || true)
    [ -n "$session" ] || session=null
    held=$(impl_lock_holder "$slug" || true)
    while IFS= read -r event; do
      [ -n "$event" ] || continue
      printf '%s' "$event" | jq -c --arg route "$(event_route "$slug" "$event")" \
        '. + {route: (if $route == "" then null else $route end)}'
    done < <(open_request_events "$slug") \
      | jq -s --arg slug "$slug" --argjson session "$session" --arg lock "$held" \
          '{slug:$slug, session:$session,
            lock:(if $lock == "" then null else $lock end),
            requests:.}'
  done
  exit 0
fi

if [ ${#slugs[@]} -eq 0 ]; then
  log_info "no requests recorded yet"
  exit 0
fi

found=0
for slug in "${slugs[@]}"; do
  session=$(running_get "$slug" || true)
  if [ -n "$session" ]; then
    log_info "overseer session on [$slug]: pid $(printf '%s' "$session" | jq -r '.pid'), since $(printf '%s' "$session" | jq -r '.started_at')"
  fi
  held=$(impl_lock_holder "$slug" || true)
  if [ -n "$held" ]; then
    log_info "exclusive phase on [$slug]: held by $held"
  fi
  while IFS= read -r event; do
    [ -n "$event" ] || continue
    if [ "$found" -eq 0 ]; then
    printf '%-32s %-14s %-10s %-22s %-21s %s\n' ID SLUG STEP STATUS UPDATED TITLE
    fi
    found=1
    route=$(event_route "$slug" "$event")
    printf '%-32s %-14s %-10s %-22s %-21s %s\n' \
      "$(printf '%s' "$event" | jq -r '.id')" \
      "$slug" \
      "$(printf '%s' "$event" | jq -r '.step')" \
      "$(printf '%s' "$event" | jq -r '.status')${route:+ (→$route)}" \
      "$(printf '%s' "$event" | jq -r '.at')" \
      "$(printf '%s' "$event" | jq -r '.title')"
  done < <(open_request_events "$slug")
done

[ "$found" -eq 1 ] || log_info "no open requests"
