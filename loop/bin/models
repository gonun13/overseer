#!/usr/bin/env bash
# Show or set the loop's per-provider, per-step model allocation
# (loop/models.json — see db.sh's step_model/overseer_model). Read-only
# without a subcommand; `set` is the only mutator. Mirrors loop/bin/provider's
# shape, one level down: that script picks which provider the loop runs on,
# this one configures the model each provider's overseer and steps use.
#
# Usage: loop/bin/models [--json]
#        loop/bin/models set <provider> <step|overseer> <model>
#        loop/bin/models list-models [<provider>]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/providers.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/models [--json]
       loop/bin/models set <provider> <step|overseer> <model>
       loop/bin/models list-models [<provider>]

Reads or writes loop/models.json, the per-provider model allocation
db.sh's step_model and overseer_model read (ahead of the LOOP_STEPS
model_hint column for a step, and ahead of "whatever the session opens on"
for the overseer, which has no LOOP_STEPS column at all).

With no arguments, prints one line per loop-runnable provider and slot.
--json prints the same information machine-readably:
  { "providers": {"<id>": {"overseer": <model|null>, "steps": {"<step>": <model>}}},
    "steps": ["request", ..., "review"],
    "current": "<id>" }
`steps` is read from db.sh's step_names, so this is the source of truth a
caller (the app included) reads instead of duplicating the step list.

set <provider> <step|overseer> <model>
  Writes one slot. <provider> must be a provider the loop can run
  (loop/bin/provider lists them). <step|overseer> is a known step name or
  the literal "overseer". <model> is the model id to use, or "" to clear the
  slot back to inherit (session default, or that step's LOOP_STEPS hint).

This does not select which provider the loop runs on — that is
loop/bin/provider — and setting a step's model does not by itself make a
provider delegate that step to a subagent: see `subagents_available` in
loop/bin/step's output and providers/<id>/manifest.json's `loopSubagents`
field, which is what actually gates delegation.

list-models [<provider>]
  The models <provider> (default: the loop's currently selected one) can
  actually be set to, as JSON: {"models":[{"value","label"}...],
  "defaultModel"}. Asks the provider's own CLI directly — each bundle's
  `provider_list_models` (providers/<id>/provider.sh) — independent of
  whatever provider the *app* has attached, so this answers for any
  loop-runnable provider, signed in or not (an unreachable/signed-out CLI
  reports an empty list rather than failing the command).

Exit codes: 0 ok, 1 usage/validation failure.
USAGE
}

require_cmd jq

json_mode=0
if [ "${1:-}" = "--json" ]; then
  json_mode=1
  shift
fi

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

# all_providers_json — every loop-runnable provider's {overseer, steps},
# keyed by id, `overseer`/absent steps normalized to null/{}.
all_providers_json() {
  local id acc='{}'
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    acc=$(jq -c --argjson acc "$acc" --arg id "$id" \
      --argjson cfg "$(provider_models_json "$id")" \
      -n '$acc + {($id): {overseer: ($cfg.overseer // null), steps: ($cfg.steps // {})}}')
  done < <(list_provider_ids)
  printf '%s' "$acc"
}

if [ $# -eq 0 ]; then
  providers_json=$(all_providers_json)
  steps_json=$(step_names | jq -R . | jq -sc .)
  current=$(resolve_provider_id)

  if [ "$json_mode" -eq 1 ]; then
    jq -n --argjson providers "$providers_json" --argjson steps "$steps_json" --arg current "$current" \
      '{providers: $providers, steps: $steps, current: $current}'
    exit 0
  fi

  printf 'Loop model allocation (current provider: %s)\n\n' "$current"
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    printf '%s:\n' "$id"
    printf '  %-10s %s\n' overseer \
      "$(printf '%s' "$providers_json" | jq -r --arg id "$id" '.[$id].overseer // "inherit"')"
    while IFS= read -r step; do
      val=$(printf '%s' "$providers_json" | jq -r --arg id "$id" --arg s "$step" '.[$id].steps[$s] // "inherit"')
      printf '  %-10s %s\n' "$step" "$val"
    done < <(step_names)
    printf '\n'
  done < <(list_provider_ids)
  exit 0
fi

case "$1" in
  set)
    shift
    [ $# -eq 3 ] || { usage; exit 1; }
    provider=$1 slot=$2 model=$3

    is_loop_bundle "$provider" \
      || die "unknown provider '$provider' — loop/bin/provider lists what the loop can run" 1

    if [ "$slot" != "overseer" ]; then
      case " $(step_names | tr '\n' ' ') " in
        *" $slot "*) : ;;
        *) die "unknown step '$slot' — known steps: $(step_names | tr '\n' ' '), or 'overseer'" 1 ;;
      esac
    fi

    f=$(models_file)
    current_json='{}'
    [ -s "$f" ] && current_json=$(cat "$f")

    tmp=$(mktemp "${f}.XXXXXX")
    if [ "$slot" = "overseer" ]; then
      jq --arg id "$provider" --arg model "$model" \
        'if $model == "" then .[$id].overseer = null else .[$id].overseer = $model end' \
        <<<"$current_json" >"$tmp"
    else
      jq --arg id "$provider" --arg step "$slot" --arg model "$model" '
        if $model == "" then
          .[$id].steps |= ((. // {}) | del(.[$step]))
        else
          .[$id].steps[$step] = $model
        end
      ' <<<"$current_json" >"$tmp"
    fi
    mv "$tmp" "$f"
    log_info "set $provider $slot = ${model:-<inherit>}"
    ;;
  list-models)
    shift
    [ $# -le 1 ] || { usage; exit 1; }
    target=${1:-$(resolve_provider_id)}

    is_loop_bundle "$target" \
      || die "unknown provider '$target' — loop/bin/provider lists what the loop can run" 1

    # Subshelled: LOOP_PROVIDER scoped to this one load, and provider.sh's
    # functions (sourced by load_provider) never leak into a second
    # `list-models` call in the same process.
    (
      LOOP_PROVIDER=$target load_provider
      if ! declare -F provider_list_models >/dev/null; then
        die "provider '$target' cannot list its models (no provider_list_models in its provider.sh)" 1
      fi
      provider_list_models
    )
    ;;
  -*)
    die "unknown option: $1" 1
    ;;
  *)
    usage
    exit 1
    ;;
esac
