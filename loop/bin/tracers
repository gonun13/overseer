#!/usr/bin/env bash
# List one request's vertical tracers: what the plan decomposed the work into,
# which of them the implement record already marks done, and which go together
# in one run because the plan declared them parallel.
#
# This exists so the overseer can decide what to implement next without reading
# the plan into its own window. Read-only — it writes nothing.
#
# Usage: loop/bin/tracers <workspace-name> <request-id> [--json | --next | --last]
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/bin/tracers <workspace-name> <request-id> [--json | --next | --last]

Lists the vertical tracers in that request's plan, in plan order, with the
phase they belong to, whether the plan declared them parallel, and their
status from the implement record's ledger (pending until it says otherwise).

--json  one object per tracer: {tracer, phase, phase_label, parallel, status,
        goal}. The form to read from a script or an agent.
--next  print only the next group to implement, comma-separated and ready to
        pass to `loop/bin/step ... implement --tracer`. That is every pending
        parallel tracer of the lowest phase with work left, or the single next
        pending tracer when it is not parallel. Prints nothing when the plan
        is fully implemented.
--last  print the group the last implement run actually built, from that
        record's own `tracers` frontmatter. This is what `verify` checks and
        what a reworked `implement` run redoes — `--next` is the wrong answer
        for both, because a recorded run has already marked its tracers done.
        Prints nothing when there is no implement record yet.

Exit codes: 0 ok, 1 general failure, 2 workspace not found.
USAGE
}

require_cmd jq

name="" id="" as_json=0 next_only=0 last_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) as_json=1; shift ;;
    --next) next_only=1; shift ;;
    --last) last_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" 1 ;;
    *)
      if [ -z "$name" ]; then name=$1
      elif [ -z "$id" ]; then id=$1
      else die "unexpected extra argument: $1" 1
      fi
      shift
      ;;
  esac
done

[ -n "$name" ] && [ -n "$id" ] || { usage; exit 1; }
[ $((as_json + next_only + last_only)) -le 1 ] \
  || die "pass at most one of --json, --next, --last" 1

validate_workspace_name "$name"
slug=$(slugify "$name")

# --last reads the implement record, not the plan, so it answers even for a
# request whose plan was rewritten under it — the group that was built is a
# fact about the run, not about the current decomposition.
if [ "$last_only" -eq 1 ]; then
  impl_file=$(artifact_path "$slug" implement "$id")
  [ -f "$impl_file" ] || exit 0
  last=$(record_frontmatter_get "$impl_file" tracers)
  [ -n "$last" ] || exit 0
  printf '%s\n' "$last"
  exit 0
fi

plan_file=$(artifact_path "$slug" plan "$id")
[ -f "$plan_file" ] || die "no plan for $id — $(artifact_ref "$slug" plan "$id") does not exist" 1

# The ledger is the implement record's own table, so a tracer is done only once
# a run has said so. No record yet means nothing is done.
declare -A status_of=()
while IFS=$'\t' read -r t s; do
  [ -n "$t" ] || continue
  status_of["$t"]=$s
done < <(ledger_statuses "$(artifact_path "$slug" implement "$id")")

rows=()
while IFS= read -r row; do
  [ -n "$row" ] || continue
  rows+=("$row")
done < <(plan_tracers "$plan_file")

[ ${#rows[@]} -gt 0 ] || die "no tracers found in $(artifact_ref "$slug" plan "$id")" 1

# --next: the lowest phase with anything pending decides the group. Within it,
# a pending parallel tracer brings its pending parallel siblings along; a
# serial one goes alone. Bash settles this rather than the overseer, because
# "which of these may run together" is a rule, not a judgement call.
if [ "$next_only" -eq 1 ]; then
  phase="" lead_parallel="" group=()
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r t p par _label _goal <<<"$row"
    [ "${status_of[$t]:-pending}" = "done" ] && continue
    if [ -z "$phase" ]; then
      phase=$p
      lead_parallel=$par
      group+=("$t")
      [ "$par" = "true" ] || break
      continue
    fi
    [ "$p" = "$phase" ] || break
    [ "$lead_parallel" = "true" ] && [ "$par" = "true" ] || continue
    group+=("$t")
  done
  [ ${#group[@]} -gt 0 ] || exit 0
  printf '%s\n' "$(IFS=,; printf '%s' "${group[*]}")"
  exit 0
fi

if [ "$as_json" -eq 1 ]; then
  for row in "${rows[@]}"; do
    IFS=$'\t' read -r t p par label goal <<<"$row"
    jq -nc --arg t "$t" --argjson p "$p" --arg label "$label" \
      --argjson par "$par" --arg s "${status_of[$t]:-pending}" --arg goal "$goal" \
      '{tracer:$t, phase:$p, phase_label:$label, parallel:$par, status:$s, goal:$goal}'
  done | jq -s .
  exit 0
fi

for row in "${rows[@]}"; do
  IFS=$'\t' read -r t p par _label goal <<<"$row"
  kind=serial
  [ "$par" = "true" ] && kind=parallel
  printf '%-8s phase %-3s %-8s %-9s %s\n' \
    "$t" "$p" "$kind" "${status_of[$t]:-pending}" "$goal"
done
