# Runtime file-store — recreated by loop/run; never versioned.
/db/

# Local provider selection (loop/bin/provider). Default without this file is
# claude-code; LOOP_PROVIDER still overrides at runtime when set.
/.provider

# Per-provider model allocation (loop/bin/models). Absent entirely falls back
# to the LOOP_STEPS model_hint column — see db.sh's step_model/overseer_model.
/models.json
