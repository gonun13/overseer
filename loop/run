#!/usr/bin/env bash
# The `run` entrypoint, and the whole of it: open an interactive session on the
# configured provider agent, pointed at the overseer instructions. That session
# *is* the loop — it reads state with loop/bin/*, decides what runs next,
# delegates steps to subagents, and talks to the human. This script does not
# orchestrate; it validates, leases the workspace, and hands over the terminal.
#
# Usage: loop/run <workspace-name>
set -euo pipefail

SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/bin/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/db.sh"
# shellcheck disable=SC1091
source "$LOOP_BIN_DIR/lib/providers.sh"

usage() {
  cat >&2 <<'USAGE'
usage: loop/run <workspace-name>

Opens an interactive overseer session on the configured provider agent for
workspace/<workspace-name>. The overseer picks up whatever is open — resuming
a request mid-flight, planning one already scoped — or asks for a new request
when nothing is pending, and keeps going until you stop it.

Requires an interactive terminal: the overseer talks to you. Use
loop/bin/provider to choose which agent CLI runs it, loop/bin/list to see
what is open without starting a session.

Exit codes: 0 ok, 1 general/provider failure, 2 workspace not found,
4 no terminal attached, 5 another overseer session holds this workspace,
6 run from the host instead of the container.
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

[ $# -eq 1 ] || { usage; exit 1; }
name=$1

# The session this opens holds Write, Edit and an unprefixed Bash, and a
# subagent of it inherits all three — the widest grant anywhere in this repo.
# It belongs in the container with the workspace, not on the machine that owns
# it. OVERSEER_IN_CONTAINER is set only by the image, so this fails on the host
# no matter what is installed there; bin/_in-container.sh guards the app's own
# npm scripts the same way. The loop/bin/* commands are deliberately not
# guarded: they read and record state, they open no session.
if [ "${OVERSEER_IN_CONTAINER:-}" != "1" ]; then
  die "refusing to open an overseer session on the host — use ./bin/loop $name

  The loop runs in the same container the app does, with the same workspace,
  the same provider registry, and the same signed-in CLIs. Running it here
  would put an agent with edit and shell access on your own machine.

    ./bin/loop $name          open the session
    ./bin/loop list $name     read what is open, without starting one" 6
fi

if [ ! -t 0 ] || [ ! -t 1 ]; then
  die "loop/run requires an interactive terminal — the overseer needs to talk to you" 4
fi

require_cmd jq
workspace_dir=$(resolve_workspace "$name")
slug=$(slugify "$name")
load_provider

if ! running_claim "$slug"; then
  die "workspace '$name' already has an overseer session (see the holder above)" 5
fi
trap 'running_release "$slug"' EXIT

# Point at the instructions rather than inlining them: the overseer re-reads
# them as it works, and a prompt this short can't stall a CLI on argv size.
prompt="Read $LOOP_DIR/overseer.md and act as the overseer for workspace '$name'.
LOOP_DIR=$LOOP_DIR
WORKSPACE=$name
WORKSPACE_DIR=$workspace_dir"

log_info "overseer session on '$name' via provider '$PROVIDER_ID'"
provider_session "$prompt" "$workspace_dir"
