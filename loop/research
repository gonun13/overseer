#!/usr/bin/env bash
# The `research` step: automated codebase research for a request that's
# already past `request`. Explores workspace/<name>, writes
# loop/db/<slug>/research/<id>.md as context for the upcoming `scope` step,
# and updates loop/db/<slug>/memory.md — a living document shared across
# every future request/step for this workspace. Fully automated, no human
# in the loop.
#
# Usage: loop/research <workspace-name> [--id <request-id>]
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck disable=SC1091
source "$LOOP_DIR/lib/db.sh"
# shellcheck disable=SC1091
source "$LOOP_DIR/lib/providers.sh"

usage() {
  cat >&2 <<'EOF'
usage: loop/research <workspace-name> [--id <request-id>]

Researches a request for the project at workspace/<workspace-name>: explores
the codebase, writes loop/db/<slug>/research/<id>.md, and updates the
shared loop/db/<slug>/memory.md.

Without --id, auto-picks the one request at step "request"/status
"requested" for this workspace. Dies if there's none, or more than one
(pass --id to disambiguate). With --id, targets that request regardless of
its current step/status — re-researching an already-researched request is
allowed on purpose.

Exit codes: 0 ok, 1 general/validation/provider failure, 2 workspace not
found, 3 no eligible request / ambiguous selection without --id.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

require_cmd jq
load_provider

name=""
id=""
while [ $# -gt 0 ]; do
  case "$1" in
    --id)
      [ $# -ge 2 ] || die "--id requires a value" 1
      id=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown option: $1" 1
      ;;
    *)
      if [ -n "$name" ]; then
        die "unexpected extra argument: $1" 1
      fi
      name=$1
      shift
      ;;
  esac
done

if [ -z "$name" ]; then
  usage
  exit 1
fi

workspace_dir=$(resolve_workspace "$name")
slug=$(slugify "$name")

if [ -n "$id" ]; then
  event=$(latest_request_events "$slug" | jq -c --arg id "$id" 'select(.id == $id)')
  [ -n "$event" ] || die "no request '$id' found for '$name'" 3
  status=$(printf '%s' "$event" | jq -r '.status')
  [ "$status" != "cleared" ] || die "request '$id' was cleared — its record no longer exists" 3
else
  candidates=()
  while IFS= read -r ev; do
    [ -n "$ev" ] || continue
    candidates+=("$ev")
  done < <(latest_request_events "$slug" | jq -c 'select(.step == "request" and .status == "requested")')

  if [ ${#candidates[@]} -eq 0 ]; then
    die "no request awaiting research for '$name' — run loop/request first, or check loop/list $name" 3
  fi
  if [ ${#candidates[@]} -gt 1 ]; then
    log_error "multiple requests awaiting research for '$name' — pass --id to disambiguate:"
    for ev in "${candidates[@]}"; do
      printf '  - %s %s\n' "$(printf '%s' "$ev" | jq -r '.id')" "$(printf '%s' "$ev" | jq -r '.title')" >&2
    done
    exit 3
  fi

  event="${candidates[0]}"
  id=$(printf '%s' "$event" | jq -r '.id')
fi

raw_ref=$(printf '%s' "$event" | jq -r '.raw_ref')

record_file=$(record_path "$slug" "$id")
[ -f "$record_file" ] || die "no request record found at db/$slug/requests/$id.md for '$id'" 1

ensure_slug_dirs "$slug"

research_file=$(research_path "$slug" "$id")
memory_file=$(memory_path "$slug")
researched_at=$(iso_now)
request_ref="db/$slug/requests/$id.md"
research_ref="db/$slug/research/$id.md"

log_info "researching $id via provider '$PROVIDER_ID'…"

if ! provider_research "$record_file" "$workspace_dir" "$memory_file" "$research_file" "$id" "$name" "$slug" "$researched_at" "$request_ref"; then
  die "research failed — request record untouched
retry with: loop/research $name --id $id" 1
fi

if ! research_is_valid "$research_file" "$id" "$slug" "$researched_at" "$request_ref"; then
  die "provider '$PROVIDER_ID' did not write a valid research record at $research_ref" 1
fi

title=$(record_title "$record_file")
[ -n "$title" ] || title="(untitled)"

append_event "$slug" "$id" "$researched_at" "research" "completed" "researched" "$title" "$raw_ref" "$research_ref"

log_info "researched $id for '$name'"
printf '%s\n' "$title"
printf '%s\n' "$research_ref"
