#!/usr/bin/env sh
# Tear the dev stack down and discard its volumes — including claude-home,
# which holds the agent's login. You will have to authenticate again.
# ./workspace is a host bind mount and is not touched.
. "$(dirname -- "$0")/_lib.sh"

require_docker

printf 'This deletes the dev node_modules volumes AND claude-home (agent auth).\nContinue? [y/N] '
read -r reply
case "$reply" in
  [yY] | [yY][eE][sS]) ;;
  *)
    echo "aborted"
    exit 1
    ;;
esac

dev_compose down -v
echo "overseer: dev volumes removed. Next ./bin/dev will reinstall and re-auth."
