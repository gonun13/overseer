#!/usr/bin/env sh
# Tear the dev stack down and discard its volumes — including agent-home,
# which holds every provider's login (the app's and the loop's alike), and
# overseer-memory, which holds the overseer's logs, action register and world
# snapshot. You will have to authenticate again, and the next boot is a first
# boot.
#
# `down -v` takes every volume the project declares, so overseer-memory and the
# workspace projects' build cache in dind-storage are covered without naming
# them. That is the intended behaviour: reset means this instance forgets what
# it learned, and an action register that outlived the machine it describes
# would be a record of something that no longer exists.
#
# ./workspace is a host bind mount and is not touched. Neither is loop/db —
# in dev it lives in the repo through the same bind mount, so a reset does not
# throw away the dev loop's request history.
. "$(dirname -- "$0")/_lib.sh"

require_docker

printf 'This deletes the dev node_modules volumes, agent-home (every provider'"'"'s\nauth, for the app and the loop), overseer-memory (the overseer'"'"'s logs and\naction register) and dind-storage (the workspace projects'"'"' built images).\nContinue? [y/N] '
read -r reply
case "$reply" in
  [yY] | [yY][eE][sS]) ;;
  *)
    echo "aborted"
    exit 1
    ;;
esac

dev_compose down -v
echo "overseer: dev volumes removed. Next ./bin/dev will reinstall and re-auth."
