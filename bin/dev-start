#!/usr/bin/env sh
# Start the dev stack. A fresh instance is headline-only until the overseer's
# wizard discovers something (see docs/overseer-behavior.md).
#
#   ./bin/dev-start           start (rebuilds images if the Dockerfile changed)
#   ./bin/dev-start --build   force an image rebuild
#   ./bin/dev-start -d        detached
. "$(dirname -- "$0")/_lib.sh"

require_docker

echo "overseer: starting dev stack — web http://127.0.0.1:5173, server http://127.0.0.1:3001"
dev_compose up "$@"
