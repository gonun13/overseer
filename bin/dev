#!/usr/bin/env sh
# Start the development stack. This is the only way to run this project for
# development — there is no host-side path.
#
#   ./bin/dev              start (rebuilds images if the Dockerfile changed)
#   ./bin/dev --build      force an image rebuild
#   ./bin/dev -d           detached
. "$(dirname -- "$0")/_lib.sh"

require_docker

echo "overseer: starting dev stack — web http://127.0.0.1:5173, server http://127.0.0.1:3000"
dev_compose up "$@"
