#!/usr/bin/env sh
# Force-rebuild Docker images (Dockerfile / CLI pin changes). Does not start
# or stop the stack — use ./bin/dev-start or ./bin/start after.
#
#   ./bin/rebuild              rebuild the dev images
#   ./bin/rebuild --prod       rebuild the production image
#   ./bin/rebuild --no-cache   extra flags pass through to `docker compose build`
. "$(dirname -- "$0")/_lib.sh"

require_docker

if [ "${1:-}" = "--prod" ]; then
  shift
  echo "overseer: rebuilding production image"
  prod_compose build "$@"
else
  echo "overseer: rebuilding dev images"
  dev_compose build "$@"
fi
