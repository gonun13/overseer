{
  "name": "overseer",
  "private": true,
  "version": "0.3.2",
  "description": "A single-page web console for driving CLI coding agents.",
  "type": "module",
  "workspaces": [
    "packages/protocol",
    "packages/web",
    "packages/server",
    "packages/adapters/*",
    "packages/e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bin/_in-container.sh && npm run dev --workspace packages/server",
    "dev:web": "bin/_in-container.sh && npm run dev --workspace packages/web",
    "build": "npm run build --workspace packages/protocol && npm run build --workspace packages/adapters/claude-code && npm run build --workspace packages/adapters/cursor && npm run build --workspace packages/web && npm run build --workspace packages/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace packages/e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "node-pty": true,
    "esbuild": true,
    "@anthropic-ai/claude-code": true
  }
}
