node_modules/
dist/
build/
*.log
.DS_Store
.env
.env.*
!.env.example

# Host-shared mount — one independent git repo per project directory.
# Overseer tracks only the empty mount point; scaffolded projects (e.g.
# overseer-personality) are created with their own `git init` at runtime.
/workspace/*
!/workspace/.gitkeep

# Playwright — ephemeral run output.
packages/e2e/playwright-report/
packages/e2e/test-results/

# Container-owned state that may appear at repo root during local dev.
.overseer/
.claude/

# The claude-code bundle's `.claude/` is versioned config — the permissions a
# loop session runs under — not container-owned runtime state. The blanket rule
# above ignores `.claude/` at any depth, so un-ignore this one. Lived in
# loop/.gitignore until the provider bundles moved to the shared providers/.
!providers/claude-code/.claude/
!providers/claude-code/.claude/**

# Keep provider instructions like CLAUDE.md or other provider-specific files on host away from repos.
CLAUDE.md