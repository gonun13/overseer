node_modules/
dist/
build/
*.log

# playwright output — reports and traces from ./bin/test-e2e, written through a
# bind mount so a failed run can be read on the host
packages/e2e/playwright-report/
packages/e2e/test-results/
.DS_Store
.env
.env.*
!.env.example

# host-shared agent workspace — never commit user projects
/workspace/*
!/workspace/.gitkeep

# container-owned volumes never land here, but guard anyway: the agent's auth,
# and the overseer's internal memory (docs/overseer.md §6.2)
.claude/
.overseer/
