{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean -f *": "deny",
      "git clean -fd *": "deny",
      "git branch -D *": "deny",
      "git checkout . *": "deny",
      "git restore . *": "deny",
      "curl *": "deny"
    }
  }
}
