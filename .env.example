# Container timezone for provider CLIs (usage / limit reset phrases).
# Docker Compose passes this into the server. Omit for UTC.
# TZ=UTC
# TZ=Europe/London
# TZ=America/New_York
# TZ=America/Los_Angeles
# TZ=Asia/Tokyo
# TZ=Asia/Seoul

# Authorship on the commits the dev loop writes (loop/bin/land). Without these
# the container has no git identity and land falls back to a tool identity,
# `overseer <overseer@localhost>` — the commit still happens, it just reads as
# the machine's rather than yours.
#
# The app's own commits are authored from settings › git access instead, which
# is the better place: it applies without a restart and beats these, since git
# reads these variables ahead of every config file.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# Pushing needs no token here. Generate an ssh key in settings › git access and
# add its public half to your git host — that works for every host, including
# self-hosted ones, and nothing secret is ever stored on the host side.
